# shellcheck shell=sh disable=SC2034

# Define path to documents
TEYUNA_RULEBOOK=teyuna/docs/rulebook.md
TEYUNA_HOWTO=teyuna/docs/howto.md

# pydantic-ai model id (`provider:model`). Credentials use the provider's own env vars.
# TEYUNA_LLM_MODEL=openai:gpt-4o
# OPENAI_API_KEY=sk-...

# TEYUNA_LLM_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=...

# TEYUNA_LLM_MODEL=bedrock:openai.gpt-oss-120b-1:0
# AWS credentials come from the usual boto3 chain (env, profile, etc.)

# TEYUNA_LLM_MODEL=ollama:llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1
